# Auto-generated on first API startup if left blank, then written back here.
TOOLGATE_ADMIN_KEY=

# Comma-separated browser origins allowed to call the local API.
TOOLGATE_DASHBOARD_ORIGINS=http://localhost:8011,http://127.0.0.1:8011

# Internal read-only service integration. Values remain write-only in ToolGate.
MEMORYGATE_URL=http://memorygate-api:8020
MEMORYGATE_READ_KEY=
TOOLGATE_CALLBACK_SECRET=

GITHUB_TOKEN=
RAILWAY_API_KEY=
VERCEL_TOKEN=
SUPABASE_SERVICE_KEY=
SUPABASE_URL=
RESEND_API_KEY=
TAVILY_API_KEY=
